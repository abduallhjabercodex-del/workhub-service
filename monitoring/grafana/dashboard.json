{
  "title": "WorkHub Enterprise Observability & Operations",
  "uid": "adg7ldb",
  "tags": [
    "workhub",
    "production",
    "sre",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Throughput",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(workhub_http_requests_total[1m])) or vector(0)",
          "legendFormat": "Req/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "sparkline": {
            "show": true,
            "lineColor": "#7c5cff",
            "fillColor": "rgba(124, 92, 255, 0.2)"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Error Rate %",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 0
      },
      "targets": [
        {
          "expr": "(sum(rate(workhub_http_requests_total{status=~\"5..\"}[1m])) or vector(0)) / (sum(rate(workhub_http_requests_total[1m])) > 0 or vector(1)) * 100",
          "legendFormat": "% Errors",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#eab308",
                "value": 1.0
              },
              {
                "color": "#ef4444",
                "value": 5.0
              }
            ]
          },
          "sparkline": {
            "show": true
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "API Latency (P95)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(workhub_http_request_duration_seconds_bucket[5m])) by (le)) or vector(0.015)",
          "legendFormat": "P95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#eab308",
                "value": 0.25
              },
              {
                "color": "#ef4444",
                "value": 0.5
              }
            ]
          },
          "sparkline": {
            "show": true
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "\u26a1 Circuit Breaker Status",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 9,
        "y": 0
      },
      "targets": [
        {
          "expr": "workhub_cache_circuit_state or vector(0)",
          "legendFormat": "State",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CLOSED (HEALTHY \ud83d\udfe2)",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "HALF-OPEN (PROBING \ud83d\udfe1)",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "OPEN (TRIPPED \ud83d\udd34)",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 7,
      "title": "\ud83d\udeab Rate Limit (429 Drops)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 13,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(workhub_rate_limit_rejected_total[1m])) or vector(0)",
          "legendFormat": "429/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          },
          "sparkline": {
            "show": true
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 5,
      "title": "Worker Queue Depth",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "workhub_worker_queue_depth or vector(0)",
          "legendFormat": "Jobs",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "sparkline": {
            "show": true
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "DB Pool (Idle)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "expr": "workhub_db_pool_connections{state=\"idle\"} or vector(5)",
          "legendFormat": "Idle conns",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "sparkline": {
            "show": true
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 10,
      "title": "\ud83d\ude80 HTTP Traffic Rate by Route & Method (Req/Sec)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum(rate(workhub_http_requests_total[1m])) by (method, route)",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 18,
            "gradientMode": "opacity"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "title": "\u26a1 Circuit Breaker State Timeline (0=Closed, 1=Half-Open, 2=Open)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "workhub_cache_circuit_state or vector(0)",
          "legendFormat": "Circuit State",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 2,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Closed (Healthy \ud83d\udfe2)",
                  "color": "green"
                },
                "1": {
                  "text": "Half-Open (Probing \ud83d\udfe1)",
                  "color": "orange"
                },
                "2": {
                  "text": "Open (Tripped \ud83d\udd34)",
                  "color": "red"
                }
              }
            }
          ],
          "custom": {
            "lineInterpolation": "stepAfter",
            "lineWidth": 3,
            "fillOpacity": 30,
            "gradientMode": "opacity"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 20,
      "title": "\ud83d\uddc4\ufe0f Database Query Rate by Table & Operation",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum(rate(workhub_db_query_duration_seconds_count[1m])) by (operation, table) or vector(0)",
          "legendFormat": "{{operation}} {{table}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 21,
      "title": "\ud83d\udee1\ufe0f Resilience: Rate Limiting (429) & Load Shedding (503)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum(rate(workhub_rate_limit_rejected_total[1m])) by (scope) or vector(0)",
          "legendFormat": "Rate Limit 429 ({{scope}})",
          "refId": "A"
        },
        {
          "expr": "rate(workhub_load_shed_rejected_total[1m]) or vector(0)",
          "legendFormat": "Load Shed 503 Drops",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineInterpolation": "smooth",
            "lineWidth": 3,
            "fillOpacity": 25,
            "gradientMode": "opacity"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 30,
      "title": "\u26a1 Active Goroutines",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "go_goroutines",
          "legendFormat": "Goroutines",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#2ec4b6"
          },
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          }
        }
      }
    },
    {
      "id": 31,
      "title": "\ud83d\udcbe Memory Footprint (RSS)",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "Resident RSS",
          "refId": "A"
        }
