      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "fixed",
            "fixedColor": "#7c5cff"
          },
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          }
        }
      }
    },
    {
      "id": 32,
      "title": "\u23f1\ufe0f Avg GC Pause Duration",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
