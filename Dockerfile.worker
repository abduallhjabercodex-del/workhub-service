# Multi-stage Dockerfile for WorkHub Background Worker
# Stage 1: Build binary statically with Alpine Go compiler
FROM alpine:latest AS builder

RUN apk add --no-cache go

WORKDIR /app

# Native Docker layer caching for dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy application source code
COPY . .

# Compile fully static, stripped binary with strict flags
RUN CGO_ENABLED=0 go build \
    -tags "netgo,osusergo" \
    -trimpath \
    -ldflags="-s -w -extldflags '-static'" \
    -o /bin/workhub-worker ./cmd/worker

# Stage 2: Minimal, hardened non-root runtime image
FROM alpine:latest

# Install root TLS certificates and time zone data
RUN apk add --no-cache ca-certificates tzdata

# Create dedicated unprivileged non-root user and group (UID/GID 10001)
RUN addgroup -g 10001 workhub && \
    adduser -u 10001 -G workhub -D -s /sbin/nologin workhub

# Copy compiled binary with ownership
COPY --from=builder --chown=10001:10001 /bin/workhub-worker /bin/workhub-worker

# Switch process execution to unprivileged user
USER 10001:10001

EXPOSE 9091

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget --no-verbose --tries=1 --timeout=2 --spider http://localhost:9091/healthz || exit 1

ENTRYPOINT ["/bin/workhub-worker"]
